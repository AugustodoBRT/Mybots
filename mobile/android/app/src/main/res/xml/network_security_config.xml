<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
  </domain-config>
  <!--
    The MyBots relay is reached over wss:// (TLS on port 443, a Let's Encrypt certificate), so nothing but the loopback is allowed
    without TLS. On top of the transport, the traffic is encrypted end to end by the app's own channel (pc-channel.js).
  -->
</network-security-config>
