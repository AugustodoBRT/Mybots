<?xml version="1.0" encoding="utf-8"?>
<!-- The 2×2 widget: the most recent bot, big. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mybots_widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/mybots_widget_bg"
  android:gravity="center" android:orientation="vertical" android:padding="10dp">
  <ViewFlipper android:id="@+id/mybots_widget_face" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:autoStart="true" android:flipInterval="140" />
  <TextView android:id="@+id/mybots_widget_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
    android:ellipsize="end" android:maxLines="1" android:textColor="#F3F5F9" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
  <TextView android:id="@+id/mybots_widget_preview" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:ellipsize="end" android:maxLines="1" android:textColor="#8B94A6" android:textSize="11.5sp" />
</LinearLayout>
